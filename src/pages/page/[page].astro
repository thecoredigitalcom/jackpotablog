---
import HomePage from '../../components/HomePage.astro';
import { SITE } from '../../site';
import { getPosts, paginate } from '../../lib/data';
export async function getStaticPaths() {
  const pages = paginate(await getPosts(), SITE.postsPerPage);
  return pages.slice(1).map((p) => ({ params: { page: String(p.page) } }));
}
---
<HomePage page={Number(Astro.params.page)} />
