---
import { FOOTER, SITE } from '../site';
import Social from './Social.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <a href="https://www.jackpota.com/" class="logo"><img src={SITE.logo} alt="Jackpota" width="160" height="41" loading="lazy" /></a>
    <p class="small">© {year} Jackpota.com | All rights reserved.</p>
    <h2 class="foot-h">About us</h2>
    <div class="chips">{FOOTER.about.map((l) => <a class="chip" href={l.href}>{l.label}</a>)}</div>
    <h2 class="foot-h">Games</h2>
    <div class="chips">{FOOTER.games.map((l) => <a class="chip" href={l.href}>{l.label}</a>)}</div>
    {FOOTER.social.length > 0 && (
      <>
        <h2 class="foot-h">Follow us</h2>
        <Social />
      </>
    )}
    <div class="foot-info small">
      <p>Online support 24/7: <a href="https://support.jackpota.com/hc/en-us/requests/new">Contact Us</a></p>
      <p>US Payment Related Queries (24/7): <a href="tel:+17194971126">+1 (719) 497-1126</a></p>
      <p>Please use the applicable number for your country of residence. Calls to the incorrect number for your country of residence may incur additional charges.</p>
      <p>Partner with Jackpota. Contact us here: <strong>partners at jackpota.com</strong></p>
    </div>
    <p class="legal">Jackpota.com is owned and operated by SILVER SOCIAL OPERATIONS LIMITED a company registered in the Isle of Man with registration number 021651V and registered office at Second Floor, 18-20 North Quay, Douglas, Isle of Man, IM1 4LE.</p>
  </div>
</footer>
