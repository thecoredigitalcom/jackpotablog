---
import { NAV, SITE } from '../site';
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="logo" aria-label="Jackpota Blog home"><img src={SITE.logo} alt="Jackpota" width="160" height="41" /></a>
    <nav class="nav" aria-label="Main">
      {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="cta">
      <a class="btn btn-outline" href="https://www.jackpota.com/login">Login</a>
      <a class="btn btn-gold" href="https://www.jackpota.com/register">Join Now</a>
    </div>
  </div>
</header>
